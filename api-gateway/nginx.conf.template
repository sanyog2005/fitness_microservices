events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    # Gzip Compression
    gzip on;
    gzip_types text/plain application/json application/javascript text/css;

    # Dynamic DNS Resolver (Google DNS + Cloudflare)
    # Defer resolution to runtime so Nginx starts without requiring upstreams to be registered in DNS at boot
    resolver 8.8.8.8 1.1.1.1 valid=300s ipv6=off;
    resolver_timeout 10s;

    # Extended timeouts for Render free tier cold-start wakeups (up to 120s)
    proxy_connect_timeout 120s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;

    # SSL configuration for proxying to HTTPS upstreams on Render
    proxy_ssl_server_name on;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;

    server {
        listen ${PORT};
        server_name localhost;

        client_max_body_size 50M;

        # Unified CORS Headers
        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;

        # Handle Preflight OPTIONS requests
        if ($request_method = 'OPTIONS') {
            return 204;
        }

        # Central Gateway Health Check (Responds immediately for Render health checks)
        location /api/ping {
            default_type application/json;
            return 200 '{"status":"ok","gateway":"fitness-api-gateway"}';
        }

        # 1. Auth & User Service (Dynamic upstream resolution)
        location /api/auth {
            set $upstream_auth "${AUTH_SERVICE_URL}";
            proxy_pass $upstream_auth$request_uri;
            proxy_set_header Host ${AUTH_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/user {
            set $upstream_auth "${AUTH_SERVICE_URL}";
            proxy_pass $upstream_auth$request_uri;
            proxy_set_header Host ${AUTH_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # 2. Event & Pass Service
        location /api/events {
            set $upstream_event "${EVENT_SERVICE_URL}";
            proxy_pass $upstream_event$request_uri;
            proxy_set_header Host ${EVENT_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/passes {
            set $upstream_event "${EVENT_SERVICE_URL}";
            proxy_pass $upstream_event$request_uri;
            proxy_set_header Host ${EVENT_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # 3. Booking & Catalog Service
        location /api/bookings {
            set $upstream_booking "${BOOKING_SERVICE_URL}";
            proxy_pass $upstream_booking$request_uri;
            proxy_set_header Host ${BOOKING_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/products {
            set $upstream_booking "${BOOKING_SERVICE_URL}";
            proxy_pass $upstream_booking$request_uri;
            proxy_set_header Host ${BOOKING_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/cars {
            set $upstream_booking "${BOOKING_SERVICE_URL}";
            proxy_pass $upstream_booking$request_uri;
            proxy_set_header Host ${BOOKING_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # 4. Payment & Order Service
        location /api/payments {
            set $upstream_payment "${PAYMENT_SERVICE_URL}";
            proxy_pass $upstream_payment$request_uri;
            proxy_set_header Host ${PAYMENT_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/coupons {
            set $upstream_payment "${PAYMENT_SERVICE_URL}";
            proxy_pass $upstream_payment$request_uri;
            proxy_set_header Host ${PAYMENT_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/settings {
            set $upstream_payment "${PAYMENT_SERVICE_URL}";
            proxy_pass $upstream_payment$request_uri;
            proxy_set_header Host ${PAYMENT_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
