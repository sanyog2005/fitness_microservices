events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    # Gzip Compression
    gzip on;
    gzip_types text/plain application/json application/javascript text/css;

    # DNS Resolver for resolving dynamic cloud domains (Render, Atlas, Cloudflare)
    resolver 8.8.8.8 8.8.4.4 valid=300s ipv6=off;
    resolver_timeout 10s;

    # Extended timeouts to accommodate Render Free Tier cold-start wakeups (up to 120s)
    proxy_connect_timeout 120s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;

    # SSL configuration for proxying to HTTPS upstreams on Render
    proxy_ssl_server_name on;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;

    server {
        listen ${PORT};
        server_name localhost;

        client_max_body_size 50M;

        # Unified CORS Headers
        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, PATCH, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;

        # Handle Preflight OPTIONS requests
        if ($request_method = 'OPTIONS') {
            return 204;
        }

        # Central Gateway Health Check
        location /api/ping {
            default_type application/json;
            return 200 '{"status":"ok","gateway":"fitness-api-gateway"}';
        }

        # 1. Auth & User Service
        location /api/auth {
            proxy_pass ${AUTH_SERVICE_URL}/api/auth;
            proxy_set_header Host ${AUTH_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/user {
            proxy_pass ${AUTH_SERVICE_URL}/api/user;
            proxy_set_header Host ${AUTH_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # 2. Event & Pass Service
        location /api/events {
            proxy_pass ${EVENT_SERVICE_URL}/api/events;
            proxy_set_header Host ${EVENT_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/passes {
            proxy_pass ${EVENT_SERVICE_URL}/api/passes;
            proxy_set_header Host ${EVENT_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # 3. Booking & Catalog Service
        location /api/bookings {
            proxy_pass ${BOOKING_SERVICE_URL}/api/bookings;
            proxy_set_header Host ${BOOKING_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/products {
            proxy_pass ${BOOKING_SERVICE_URL}/api/products;
            proxy_set_header Host ${BOOKING_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/cars {
            proxy_pass ${BOOKING_SERVICE_URL}/api/cars;
            proxy_set_header Host ${BOOKING_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # 4. Payment & Order Service
        location /api/payments {
            proxy_pass ${PAYMENT_SERVICE_URL}/api/payments;
            proxy_set_header Host ${PAYMENT_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/coupons {
            proxy_pass ${PAYMENT_SERVICE_URL}/api/coupons;
            proxy_set_header Host ${PAYMENT_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/settings {
            proxy_pass ${PAYMENT_SERVICE_URL}/api/settings;
            proxy_set_header Host ${PAYMENT_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
